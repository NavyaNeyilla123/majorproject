# KnowledgeOps AI - environment variables (Step 8: RAG + Qdrant)
# The application reads process environment variables directly (no .env loader).
# Copy this file's values into your shell/session environment as needed.
# Never commit real secrets.

# --- MCP (Step 7 mock, Step 10 real) ------------------------------------------
# mock (default): fully offline in-process mock MCP server - no network, no
# credentials, deterministic. real: opt-in adapter that connects to actual
# GitHub/Gmail MCP servers using the variables below. The real adapter is
# read-only, never falls back to mock, and reports "unconfigured" until a
# server is configured (never a false "connected").
MCP_PROVIDER=mock

# Per-operation timeouts for real MCP sessions (milliseconds).
MCP_CONNECT_TIMEOUT_MS=10000
MCP_CALL_TIMEOUT_MS=15000

# --- GitHub MCP server (real mode) --------------------------------------------
# Choose ONE transport. Neither is configured by default.
# Streamable HTTP endpoint:
#MCP_GITHUB_URL=https://your-github-mcp-host/mcp
# Or stdio command (e.g. npx @modelcontextprotocol/server-github):
#MCP_GITHUB_COMMAND=npx
#MCP_GITHUB_ARGS=-y,@modelcontextprotocol/server-github
# Personal access token: set the value directly, or point TOKEN_ENV at an
# env var name that holds it (preferred - keeps secrets out of this file).
#MCP_GITHUB_TOKEN=
#MCP_GITHUB_TOKEN_ENV=GITHUB_PERSONAL_ACCESS_TOKEN
# Default owner/repository scope so operations needing them can run without
# per-call arguments:
#MCP_GITHUB_OWNER=your-org
#MCP_GITHUB_REPO=your-repo
# Optional JSON map of operation key -> advertised tool name, for servers
# whose read-only tool names do not match the built-in heuristics, e.g.
# {"search.repositories":"repo_search","get.issue":"issue_read"}
#MCP_GITHUB_MAP=

# --- Gmail MCP server (real mode) ---------------------------------------------
# Community server wired but UNCONFIGURED by default; healthy/connected only
# after its live tools/list succeeds. Example stdio setup (OAuth credentials
# live in the server's own config directory, never in this repo):
#MCP_GMAIL_COMMAND=npx
#MCP_GMAIL_ARGS=-y,@gongrzhe/server-gmail-autoauth-mcp
#MCP_GMAIL_URL=
#MCP_GMAIL_TOKEN=
#MCP_GMAIL_TOKEN_ENV=
# Gmail API userId ("me" for the authenticated account):
#MCP_GMAIL_USER_ID=me
#MCP_GMAIL_MAP=

# --- LLM (Step 9) -----------------------------------------------------------
# mock (default): deterministic grounded provider, no API key, no network.
# openai-compatible (aliases: openai, http): OpenAI-compatible chat completions.
# Empty or unknown -> provider unavailable; the pipeline uses the
# deterministic fallback answer and reports it in the stage trace.
LLM_PROVIDER=mock
# Model name for HTTP providers (ignored by the mock provider).
#LLM_MODEL=gpt-4o-mini
# API key for HTTP providers - never commit real keys.
#LLM_API_KEY=
# Base URL of an OpenAI-compatible API (default: https://api.openai.com/v1).
#LLM_BASE_URL=https://api.openai.com/v1
# Request timeout in seconds for HTTP providers.
#LLM_TIMEOUT_SECONDS=30

# --- Qdrant -----------------------------------------------------------------
# Leave QDRANT_URL empty to use the embedded qdrant-client (persistent local
# storage at QDRANT_PATH). Set it to connect to a real Qdrant server instead,
# e.g. QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
# Collection name used by the RAG layer - do not change casually.
QDRANT_COLLECTION=knowledgeops_projects
# Storage path for embedded mode (created on first index run).
QDRANT_PATH=

# --- Embeddings -------------------------------------------------------------
# local-hash: deterministic feature-hashing embeddings (development/testing).
# No external paid embedding API, no API keys required.
EMBEDDING_PROVIDER=local-hash
# Dimension must match the vector collection (UI config: 1,536).
EMBEDDING_DIM=1536

# --- RAG --------------------------------------------------------------------
# Default top_k for /api/rag/search.
RAG_TOP_K=10

# --- Data -------------------------------------------------------------------
# DATA_ROOT=/absolute/path/to/data
